# Application Configuration
APP_NAME="Tender and Procurement Evaluation System"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="dev-insecure-secret-key-change-in-production"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Database Configuration
# Local Development (SQLite asyncio):
DATABASE_URL="sqlite+aiosqlite:///./procurement.db"
# Enterprise Production (PostgreSQL asyncio):
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/procurement"

# Document Storage Path
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB

# RAG & Embeddings
CHROMA_PERSIST_DIR="./chroma_db"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Microsoft Agent Framework / LLM Settings (Set your provider keys when ready)
OPENAI_API_KEY=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT=""
OPENAI_MODEL="gpt-4o"

